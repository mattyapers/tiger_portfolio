flowchart TD
    A["🖥️ You run: python main.py"] --> B["main.py starts"]
    
    B --> C["Stage 1: extract.py"]
    C --> C1["Connect to Tiger API\n(RSA key authenticates you)"]
    C1 --> C2["get_positions()\n→ What do I own? How many shares?"]
    C2 --> C3["get_prime_assets()\n→ What's my cash balance?"]
    C3 --> C4["get_stock_briefs()\n→ What are current prices & P/E?"]
    C4 --> D["Raw data: pandas DataFrame\n(like a SQL table in memory)"]
    
    D --> E["Stage 2: transform.py"]
    E --> E1["classify_tiers()\n→ Tag each position: Core / Satellite"]
    E1 --> E2["calculate_weights()\n→ What % is each position?"]
    E2 --> E3["generate_rebalance_signals()\n→ Compare weight vs target\n→ Flag: TRIM / ADD / HOLD"]
    E3 --> E4["score_entry_exit()\n→ P/E vs 5Y average\n→ Score 1-5 (lower = better value)"]
    E4 --> F["Analytics dict:\nholdings + signals + scores"]
    
    F --> G["Stage 3: load.py"]
    G --> G1["write_holdings_sheet()\n→ Data + Excel formulas"]
    G1 --> G2["write_rebalance_sheet()\n→ Color-coded signals"]
    G2 --> G3["write_dashboard_sheet()\n→ Summary view"]
    G3 --> H["📊 portfolio_tracker.xlsx\nOpen in Excel → review → act"]

    style A fill:#1a1a2e,color:#fff
    style H fill:#0d3b66,color:#fff
    style D fill:#FFFDE7,color:#000
    style F fill:#FFFDE7,color:#000
