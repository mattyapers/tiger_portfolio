{
  "env": {
    "MAX_THINKING_TOKENS": "5000",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "50",
    "CLAUDE_CODE_DISABLE_BACKGROUND_TASKS": "true"
  },
  "permissions": {
    "allow": [
      "Bash(python main.py --offline)",
      "Bash(pip install *)",
      "Bash(python main.py --yf-only)",
      "Bash(echo \"EXIT_CODE=$?\")",
      "PowerShell(python main.py --yf-only 2>&1 | Out-String; Write-Output \"EXIT=$LASTEXITCODE\")",
      "WebSearch"
    ]
  }
}
