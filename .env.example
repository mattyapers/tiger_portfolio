# Tiger Brokers API credentials — copy this file to .env and fill in your values.
# Never commit .env to version control.

TIGER_ID=your_tiger_id_here
TIGER_ACCOUNT=your_account_number_here
TIGER_PRIVATE_KEY_PATH=config/tiger_private_key.pem
TIGER_LICENSE=TBSG

# IBKR API — used only with --ibkr / --multi-broker (modules/extract_ibkr.py).
# Requires TWS or IB Gateway running locally. Port: 7497=TWS paper, 7496=TWS live,
# 4002=Gateway paper, 4001=Gateway live.
IBKR_HOST=127.0.0.1
IBKR_PORT=7496
IBKR_CLIENT_ID=1
IBKR_ACCOUNT=your_ibkr_account_id_here
